# FRONTLINE_KEY_MINT_RATE_LIMIT=10
# FRONTLINE_TRUST_ROOT_PATH=
# FRONTLINE_TRUST_ROOT_KEY_ID=default-locker-key
# FRONTLINE_TRUST_ROOT_REQUIRED=1
# FRONTLINE_SIGNING_KEY=
# FRONTLINE_SECRETS_BACKEND=env
# FRONTLINE_DB_PATH=data/frontline.duckdb
# FRONTLINE_OPS_DSN=
# FRONTLINE_ALLOW_DEFAULT_DB_RESET=0
# FRONTLINE_ALLOW_DOMAIN_DB_RESET=0
# FRONTLINE_PRUNE_DAYS=
# FRONTLINE_MAX_TURNS=12
# FRONTLINE_ENRICH_TIMEOUT_S=10
# FRONTLINE_LLM_TURN_CAP=6
