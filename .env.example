# Copy to .env for docker compose / local pilot. Never commit .env.

# Pack: automotive_nhtsa | finance_cfpb
DOMAIN_PACK=automotive_nhtsa

# --- Auth (hardened pilot / any shared network) ---
# Fail-closed: set both. Leave API key empty only for local open-mode demos.
# FRONTLINE_OPEN_MODE=1 forces open even if a key is set (local only).
# Production / SOC2 engineering mode (refuses open mode at startup):
#   ENV=production   OR   PILOT_HARDENED=1   OR   SOC2_MODE=1
# ENV=
# PILOT_HARDENED=0
# SOC2_MODE=0
# Startup refuses API_HOST=0.0.0.0 without explicit auth (item 1):
#   API_HOST=127.0.0.1                        -> local dev escape hatch (open OK)
#   API_HOST=0.0.0.0 + FRONTLINE_AUTH_REQUIRED=1 + 32-byte FRONTLINE_API_KEY
#                                             -> production configuration
#   API_HOST=0.0.0.0 + FRONTLINE_OPEN_BIND_ACK=1 -> acknowledged local pilot
#                                             only (ignored in hardened mode)
# Generate a key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# API_HOST=127.0.0.1
FRONTLINE_AUTH_REQUIRED=1
FRONTLINE_API_KEY=
SESSION_SECRET=
# SECURITY_AUDIT_LOG_PATH=data/security_audit.jsonl
# RATE_LIMIT_DEFAULT=300 per hour
# Multi-replica deployments MUST point the rate limiter at shared storage
# (item 39) or each replica enforces its own counters:
# RATELIMIT_STORAGE_URI=redis://redis:6379/0
# One-time: allow minting admin session without an admin issuer (then unset).
# FRONTLINE_BOOTSTRAP_ADMIN=0
# Shared API key is role "service" (not full admin). Legacy full admin:
# FRONTLINE_SERVICE_IS_ADMIN=0
# Query-string API keys off by default; tests may set:
# FRONTLINE_ALLOW_QUERY_KEY=0
# Production-like disables /docs and /openapi.json unless:
# FRONTLINE_OPENAPI_PUBLIC=0
# Pack activate / drain / pack disk write / DSR delete need admin session:
#   FRONTLINE_BOOTSTRAP_ADMIN=1 once, then POST /api/frontline/auth/session role=admin
# CORS allowlist (never use * with credentials):
# CORS_ALLOW_ORIGINS=http://127.0.0.1:8787,http://localhost:8000

# Google sign-in (OIDC authorization code + PKCE). Create an OAuth client in
# Google Cloud Console (Web application) and add the redirect URI below.
# You can also paste the client on the Sign-in page; it is stored in
# data/oidc_local.json (gitignored) and is refused when ENV=production.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/frontline/auth/oidc/callback
# FRONTLINE_UI_ORIGIN=http://127.0.0.1:8787

# Voice agent: how long a dropped customer WebSocket stays resumable before the
# contact is finalized. The dashboard retries for ~25s, so keep this above that.
# Set to 0 to restore the old behaviour (any socket drop ends the call).
# FRONTLINE_WS_RECONNECT_GRACE_S=120

# Optional outbound alert webhook (SSRF-guarded at runtime)
ALERT_WEBHOOK_URL=

# Pack install filesystem jail (default: <repo>/domains). Outside paths rejected.
# PACK_INSTALL_ROOT=
# When FRONTLINE_AUTH_REQUIRED=1, source_path install is disabled unless:
# PACK_INSTALL_ALLOW_SOURCE=1

# Optional BYOK LLM providers (runtime works without them)
CLAUDE_API_KEY=
OPENAI_API_KEY=

# API keys are only ever sent to the provider's official host
# (api.anthropic.com / api.openai.com). Setting ANTHROPIC_BASE_URL or
# OPENAI_BASE_URL to anything else is refused unless that host is listed here
# — routing a key through a proxy or gateway must be a deliberate choice.
# FRONTLINE_LLM_ALLOWED_HOSTS=my-llm-gateway.internal.example.com

# Intentional pilot DB rebuilds (make frontline-db / make seed-domains):
# FRONTLINE_ALLOW_DEFAULT_DB_RESET=1

# Embedding rollout (default legacy = hash embedder, no ONNX required)
# FRONTLINE_EMBEDDING_MODE=legacy|shadow|semantic|rollback
# FRONTLINE_SEMANTIC_ARTIFACT_DIR=models/minilm
# FRONTLINE_SEMANTIC_MODEL_SHA256=
# FRONTLINE_ACTIVE_CLUSTER_BUILD_ID=
# FRONTLINE_EMBEDDING_BACKFILL_BATCH=32
# FRONTLINE_ONNX_INTRA_THREADS=1
# FRONTLINE_EMBEDDING_TIMEOUT_S=8
# FRONTLINE_EMBEDDING_ALLOW_PARTIAL=0
# FRONTLINE_EMBEDDING_SHADOW_KILL=0
# FRONTLINE_SHADOW_DIVERGENCE_PCT=0.35
# FRONTLINE_EMBED_MAX_ARTIFACT_MB=80
# FRONTLINE_EMBED_MAX_RAM_MB=512
# FRONTLINE_EMBED_P50_MS=15
# FRONTLINE_EMBED_P99_MS=50

# --- FRONTLINE_* catalog (every env the runtime reads) ---
# Auth / process
# FRONTLINE_ENABLED=1
# FRONTLINE_OPEN_MODE=0
# FRONTLINE_AUTH_REQUIRED=0
# FRONTLINE_OPEN_BIND_ACK=0
# FRONTLINE_OPENAPI_PUBLIC=0
# FRONTLINE_ALLOW_QUERY_KEY=0
# FRONTLINE_BOOTSTRAP_ADMIN=0
# FRONTLINE_SERVICE_IS_ADMIN=0
# FRONTLINE_TEST_ISOLATION=0
# FRONTLINE_DISABLE_INLINE_WORKER=0
